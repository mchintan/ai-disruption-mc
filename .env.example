# ── Backend ──────────────────────────────────────────────
# Google Gemini API key (optional — falls back to curated portfolios if unset)
GEMINI_API_KEY=

# ── Frontend (only needed for docker-compose build) ─────
# Backend URL the frontend calls at runtime
# For local Docker:  http://localhost:8000
# For production:    https://your-cloud-run-url.run.app
VITE_API_URL=http://localhost:8000
